{
  "expo": {
    "name": "La Devise",
    "slug": "ladevise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ladevise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a8a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ladevise.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a8a"
      },
      "package": "com.ladevise.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 25
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RateWidget",
              "label": "La Devise Rates",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "description": "View latest black market rates",
              "previewImage": "./assets/widget-preview/preview.png"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "205817d7-3a52-4445-a5d8-124858068887"
      }
    }
  }
}
